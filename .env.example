# Release the server runs (a vX.Y.Z tag without the v); latest follows main.
OBSERVATORIO_VERSION=latest
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://observatorio:change-me@localhost:5432/observatorio

STARROCKS_HOST=starrocks-fe
STARROCKS_PORT=9030
STARROCKS_USER=observatorio_ro
STARROCKS_PASSWORD=
STARROCKS_DATABASE=dm_sst
STARROCKS_QUERY_TIMEOUT_S=30

VOYAGE_API_KEY=
RERANK_MODEL=rerank-2.5

PUBLIC_ORIGIN=https://observatorio.greencrest.com.br
OIDC_ISSUER=https://auth.greencrest.com.br/application/o/observatorio/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
ADMIN_GROUP="Observatório Admins"

# Assistant (/consulta)
ANTHROPIC_API_KEY=
ASSISTANT_DAILY_QUESTIONS=30
ASSISTANT_CONNECTION_PER_MINUTE=20
ASSISTANT_DAILY_BUDGET_USD=10
# Cloudflare's always-pass test keys work in development.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
